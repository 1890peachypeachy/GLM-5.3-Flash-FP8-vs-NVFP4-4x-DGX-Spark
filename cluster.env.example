# TEMPLATE. Copy to cluster.env and replace EVERY site value below with your own;
# cluster.env is gitignored and is the only place your site values live.
# The site-specific keys ship pre-filled with DUMMY data so the template is readable and
# self-consistent: the aliases spark1..spark4, RFC 5737 documentation addresses
# 192.0.2.11..14 for the management LAN, the 10.73.0.x switched-fabric plan and the login
# `alice`. They are NOT usable as-is: every script refuses to run while cluster.env still
# carries a `<...>` placeholder or the dummy NODES / MGMT_IPS / MASTER_IP / RELAY_DEST
# values (see scripts/lib/common.sh, scripts/tp4ctl and scripts/launcher/launch-glm53-tp4.sh).
# Everything that is NOT site-specific (image, model, window, scheduling, spec-decoding,
# the promoted EXTRA_* lines) is the production recipe of this repo: keep it as it is
# unless you are deliberately changing the lane.
# cluster.env — the single recipe of this repo: GLM-5.3-Flash FP8 weights (zai-org)
# served on 4 nodes in TP4, with the DFlash2 drafter for speculative decoding
# (no in-card MTP).
# Sourced by: scripts/launcher/launch-glm53-tp4.sh, scripts/tp4ctl, scripts/deploy.sh and
# scripts/fetch-fp8-weights.sh.
# Every placeholder value is QUOTED so that this template is itself valid bash: `bash -n
# cluster.env.example` must pass (`scripts/check.sh` checks it), and `. cluster.env.example`
# in a subshell loads it with the placeholders as literal strings.
# Values containing $HOME are single-quoted on purpose: they must be expanded ON THE
# NODE, not on the workstation that runs scripts/tp4ctl. The launcher does that expansion itself,
# with plain parameter expansion and never `eval`: it covers MODEL_DIR, DRAFT_DIR,
# NCCL_DIR, PATCH_FILE, CACHE_DIR and the source of every `-v` pair in EXTRA_DOCKER_ENV.
# Drafter: incoai/GLM-5.3-Flash-DFlash2 (base_model zai-org/GLM-5.3-Flash = exactly the
# FP8 checkpoint served here; 5 layers, block_size 8, target_layer_ids [5,14,24,33,42],
# 2.34 GB bf16). License CC BY-NC-ND 4.0 (non-commercial; contact@inco.ai for commercial
# use). Already present on the nodes as ~/models/GLM-5.3-Flash-DFlash2.

# =============================================================================
# SWITCH-ADAPTED (Scope A) — 1890peachypeachy fork
# -----------------------------------------------------------------------------
# This fork adapts the upstream switchless-ring deployment to a SWITCHED RoCE
# fabric (a CRS504-style star / single CX-7 port per node). The differences from
# the upstream template are ONLY in the network keys below:
#   * One fabric HCA per node (rocep1s0f1) instead of two comma-separated. The
#     launcher validation was patched (scripts/launcher/launch-glm53-tp4.sh) to
#     accept a single HCA; see the SWITCH-ADAPTED comment there.
#   * FABRIC_TARGETS / NETPLAN / render-netplan / tp4ctl fabric-check assume the
#     switchless ring and are NOT used on a switch — we keep our switch netplan.
#   * NCCL_DIR points at a STOCK libnccl extracted from the image (no patched-NCCL
#     build): his patched NCCL is only needed for the uncabled switchless
#     diagonals. On a switch the stock ring NCCL works.
#   * API_PORT + SERVED_NAME below match the prior NVFP4 lane so agents see the
#     same endpoint after a quant swap.
# See docs/switch-adaptation.md for the full deployment + benchmark notes.
# =============================================================================

# --- Topology: ssh aliases (from the workstation) and mgmt IPs in rank order 0..3 ---
# SITE VALUES — replace all four aliases and all four addresses.
NODES="spark1 spark2 spark3 spark4"
MGMT_IPS="192.0.2.11 192.0.2.12 192.0.2.13 192.0.2.14"

# --- Distributed rendez-vous and management network ---
MASTER_IP="192.0.2.11"
MASTER_PORT=29521
# MGMT_IF: on a switch we run control + NCCL over the SAME single fabric interface.
MGMT_IF=enp1s0f1np1
MGMT_IF_BY_RANK=()
# SECURITY: the launcher runs the container with `--network host` and vLLM binds
# 0.0.0.0:$API_PORT with NO authentication — no API key, no TLS, no allow-list.
# Run it on a TRUSTED LAN only.
API_PORT=8001

# --- Fabric: on a switch FABRIC_TARGETS is informational only (tp4ctl fabric-check
# is skipped); keep 4 entries so the parser is happy. We do NOT use render-netplan. ---
FABRIC_TARGETS=(
  "192.0.2.12 192.0.2.14"
  "192.0.2.11 192.0.2.13"
  "192.0.2.12 192.0.2.14"
  "192.0.2.11 192.0.2.13"
)
FABRIC_IFACES="enp1s0f1np1 enp1s0f1np1 enp1s0f1np1 enp1s0f1np1"
FABRIC_IFACES_BY_RANK=()
# SINGLE fabric HCA (switch). Verify your node's name with `ls /sys/class/infiniband/`.
NCCL_IB_HCA="rocep1s0f1"
NCCL_IB_HCA_BY_RANK=()
NCCL_IB_GID_INDEX=3
NCCL_IB_GID_INDEX_BY_RANK=()
NETPLAN_RENDERER=NetworkManager
NETPLAN_RENDERER_BY_RANK=()
# Only used by fetch-fp8-weights.sh fan-out legs; on a switch every node reaches every
# other node directly through the switch, so set it to any reachable peer.
RELAY_DEST='alice@192.0.2.12'

# --- Runtime ---
IMAGE=ghcr.io/tonyd2wild/vllm-glm53-flash:sm121-v11-dflash2
CONTAINER=glm53_fp8_dflash_tp4
LAUNCHER=launch-glm53-tp4.sh

# --- Paths on the nodes (expanded at runtime, on the node) ---
MODEL_DIR='$HOME/glm53-flash-fp8-zai'
MODEL_REPO=zai-org/GLM-5.3-Flash
MODEL_REV="690b705278a3a58e538fcb37c2ca8b5f9511213c"
DRAFT_DIR='$HOME/models/GLM-5.3-Flash-DFlash2'
DRAFT_REV="bf582e4eacc1810f76656d1811693ff6c6737d2a"
PATCH_FILE='$HOME/patches/sparse_attn_indexer_kpool.py'
# STOCK libnccl extracted from the image (see docs/switch-adaptation.md). NOT the
# upstream patched-NCCL build.
NCCL_DIR='$HOME/nccl-patched'
CACHE_DIR='$HOME/vllm-cache'

# --- Identity of the served model (match the prior lane -> no agent change) ---
SERVED_NAME=glm-5.3-flash

# --- Context window and KV cache ---
# Sized for a 3-4 concurrent-agent workload at ~400-480K growing context (see
# docs/switch-adaptation.md). Above 262144 the launcher injects VLLM_ALLOW_LONG_MAX_MODEL_LEN.
MAX_MODEL_LEN=491520
MAX_NUM_SEQS=12
KV_CACHE_DTYPE=fp8_e4m3

# --- Scheduling / batching ---
BATCHED_TOKENS=8192
BLOCK_SIZE=2304
GPU_MEM_UTIL=0.85

# --- Speculative decoding (DFlash2 drafter, adaptive-k) ---
SPEC_TOKENS=5
SPEC_EXTRA_JSON='\"num_speculative_tokens_per_batch_size\":[[1,1,5],[2,6,3]]'
ASYNC_SCHEDULING=0

# --- Extra docker run args (MoE JSON + adaptive-k scheduler mounts) ---
EXTRA_DOCKER_ENV='-v $HOME/tp4/moe-configs/E=288,N=512,device_name=NVIDIA_GB10,dtype=fp8_w8a8,block_shape=[128,128].json:/usr/local/lib/python3.12/dist-packages/vllm/model_executor/layers/fused_moe/configs/E=288,N=512,device_name=NVIDIA_GB10,dtype=fp8_w8a8,block_shape=[128,128].json:ro -v $HOME/patches/adaptive_k_scheduler.py:/opt/tp4/adaptive_k_scheduler.py:ro -e PYTHONPATH=/opt/tp4 -e VLLM_ADAPTIVE_K_MODE=per-request -e VLLM_ADAPTIVE_K_SEED=1.0 -e VLLM_ADAPTIVE_K_DOWN=0.42 -e VLLM_ADAPTIVE_K_UP=0.58 -e VLLM_ADAPTIVE_K_ALPHA=0.15 -e VLLM_ADAPTIVE_K_SIGNAL=pos'

# --- Extra vLLM arguments ---
EXTRA_VLLM_ARGS="--kv-cache-memory=17179869184 --moe-backend triton --scheduler-cls adaptive_k_scheduler.AdaptiveKScheduler"
